# Copy this file to .env and replace the placeholder values.
# NEVER commit the real .env file.

# Password for the SQL Server "sa" account (must meet SQL Server complexity rules).
MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# Signing key for JWT access tokens. Use at least 32 random characters.
# Generate one with:  openssl rand -base64 48
JWT_KEY=please-change-this-to-a-random-32-plus-character-secret
